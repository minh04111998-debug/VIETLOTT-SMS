                }
              },
              "queryRef": "Dim_Product.Tên Sản Phẩm",
              "nativeQueryRef": "Tên Sản Phẩm",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Sales"
                    }
                  },
                  "Property": "Doanh Thu Thuần"
                }
              },
              "queryRef": "Fact_Sales.Doanh Thu Thuần",
              "nativeQueryRef": "Doanh Thu Thuần"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'XẾP HẠNG DOANH THU THEO SẢN PHẨM'"
                }
              }
