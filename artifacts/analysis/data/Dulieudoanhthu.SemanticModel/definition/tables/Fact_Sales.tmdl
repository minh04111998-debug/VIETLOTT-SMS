table Fact_Sales
	lineageTag: 580c152b-c9f0-49cd-8a6d-5d8d2ea9b1db

	measure 'Doanh Thu Thuần' = SUM(Fact_Sales[Revenue])
		formatString: #,##0 "VNĐ"
		lineageTag: 909e32de-810e-4de6-98c1-33642e86490d

	measure 'Số Lượng Vé' = SUM(Fact_Sales[TicketCount])
		formatString: #,##0
		lineageTag: 502fb990-5263-4b06-ae65-f0babe03b85d

	measure 'Giá Vé Trung Bình' = DIVIDE([Doanh Thu Thuần], [Số Lượng Vé])
		formatString: #,##0 "VNĐ"
		lineageTag: 37acdd28-a9c9-477c-abd1-8cc72350e52d

	measure 'Tăng Trưởng MoM %' =
			VAR CurrentMonth = [Doanh Thu Thuần]
			VAR PrevMonth = CALCULATE([Doanh Thu Thuần], DATEADD('Dim_Date'[Date], -1, MONTH))
			RETURN
			DIVIDE(CurrentMonth - PrevMonth, PrevMonth)
		formatString: 0.0%
		lineageTag: a03cf059-7079-4f06-b899-138b3cf094f1

	measure 'Tăng Trưởng MoM' =
			VAR Val = [Tăng Trưởng MoM %]
			RETURN
			IF(ISBLANK(Val), "-", IF(Val >= 0, "▲ +" & FORMAT(Val, "0.0%"), "▼ " & FORMAT(Val, "0.0%")))
		lineageTag: 4131e560-4a62-454a-9173-e5fc18657c9c

	measure 'Total Revenue' = [Doanh Thu Thuần]
		formatString: #,##0 "VNĐ"
		lineageTag: 680b48d9-b660-4a20-8810-3e4e2d2da41b

	measure 'Total Tickets' = [Số Lượng Vé]
		formatString: #,##0
		lineageTag: c0aac2b1-a3e3-4c6c-a805-950c06045bfb

	measure 'Avg Ticket Price' = [Giá Vé Trung Bình]
		formatString: #,##0 "VNĐ"
		lineageTag: 040f8e05-cd6a-4173-9ecc-2564ebe3bb1f

	measure 'Revenue MoM %' = [Tăng Trưởng MoM %]
		formatString: 0.0%
		lineageTag: 5574afde-3068-41b4-9587-07f324169a37

	measure 'Revenue MoM Badge' = [Tăng Trưởng MoM]
		lineageTag: 8917884b-ef45-4728-98aa-9e8d19b0e150

	column Date
		lineageTag: f8f086a4-7dff-4bb0-84b6-2465778e69af
		isNameInferred
		sourceColumn: [Date]

	column ProductId
		lineageTag: 6729e528-bd88-4cf9-9b28-45d2bed1103e
		isNameInferred
		sourceColumn: [ProductId]

	column Channel
		lineageTag: 42bdb28e-b185-4d87-90b6-1a0d677d42ce
		isNameInferred
		sourceColumn: [Channel]

	column TicketCount
		lineageTag: b193722d-f2f5-4d5a-b2be-000f78e9a1bc
		isNameInferred
		sourceColumn: [TicketCount]

	column Revenue
		lineageTag: 3e31c8b0-e722-470e-9bc1-ba74097fe8fd
		isNameInferred
		sourceColumn: [Revenue]

	column 'Nhà Mạng'
		lineageTag: c6bea5fa-8420-4e12-bfde-a724e70383a0
		isNameInferred
		sourceColumn: [Nhà Mạng]

